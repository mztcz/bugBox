{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\":\"Kontext je plný. Napiš oktk: Claude spustí smoke test, aktualizuje mapu souborů v CLAUDE.md a pushne. Novou session si založ sám.\"}'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/smoke.cjs\" --arm"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/smoke.cjs\" --gate"
          }
        ]
      }
    ]
  }
}
