{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\":\"Kontext je plný. Napiš oktk: Claude spustí smoke test, aktualizuje mapu souborů v CLAUDE.md, pushne a založí novou session.\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/smoke.cjs\" --hook",
            "timeout": 120,
            "statusMessage": "Smoke test before push..."
          }
        ]
      }
    ]
  }
}
